<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <!-- DB credentials -->
  <context-param>
  <param-name>jdbc.url</param-name>
  <param-value>jdbc:mysql://localhost:3306/bankdb?useSSL=false&amp;serverTimezone=UTC</param-value>
</context-param>
<context-param>
  <param-name>jdbc.user</param-name>
  <param-value>root</param-value>
</context-param>
<context-param>
  <param-name>jdbc.pass</param-name>
  <param-value>12345</param-value>   <!--  your password  -->
</context-param>
  
  

  <!-- AuthFilter registered via @WebFilter -->
</web-app>
